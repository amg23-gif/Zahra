{
  "expo": {
    "name": "زهرة",
    "slug": "zahra",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "zahra",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/images/icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#2d5a3d"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.zahra.app",
      "infoPlist": {
        "UIBackgroundModes": ["audio", "fetch"],
        "NSLocationWhenInUseUsageDescription": "زهرة تحتاج موقعك لحساب أوقات الصلاة",
        "NSLocationAlwaysUsageDescription": "زهرة تحتاج موقعك لحساب أوقات الصلاة"
      }
    },
    "android": {
      "package": "com.zahra.app",
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/icon.png",
        "backgroundColor": "#2d5a3d"
      },
      "permissions": [
        "android.permission.VIBRATE",
        "android.permission.WAKE_LOCK",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.POST_NOTIFICATIONS"
      ]
    },
    "web": {
      "favicon": "./assets/images/icon.png"
    },
    "plugins": [
      [
        "expo-router",
        {
          "origin": "https://replit.com/"
        }
      ],
      "expo-font",
      "expo-web-browser",
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "زهرة تحتاج موقعك لحساب أوقات الصلاة"
        }
      ],
      "expo-av"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
