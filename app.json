{
  "expo": {
    "name": "زهرة",
    "slug": "zahra-app",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "zahra-app",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/images/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#2d5a3d"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.zahra.app",
      "infoPlist": {
        "UIBackgroundModes": ["audio", "fetch", "remote-notification"],
        "NSLocationWhenInUseUsageDescription": "زهرة تحتاج موقعك لحساب أوقات الصلاة",
        "NSLocationAlwaysUsageDescription": "زهرة تحتاج موقعك لحساب أوقات الصلاة"
      }
    },
    "android": {
      "package": "com.zahra.app",
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#2d5a3d"
      },
      "permissions": [
        "android.permission.RECEIVE_BOOT_COMPLETED",
        "android.permission.VIBRATE",
        "android.permission.WAKE_LOCK",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK",
        "android.permission.POST_NOTIFICATIONS"
      ]
    },
    "web": {
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      [
        "expo-notifications",
        {
          "icon": "./assets/images/icon.png",
          "color": "#2d5a3d",
          "sounds": ["./assets/adhan.wav"]
        }
      ],
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "زهرة تحتاج موقعك لحساب أوقات الصلاة"
        }
      ],
      "expo-av",
      "expo-background-fetch",
      "expo-task-manager"
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
